{
  "extends": "../../tsconfig.base.json",
  "include": ["next-env.d.ts", "app/**/*", "src/**/*", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "build", "dist", ".next", "**/*.test.ts"],
  "compilerOptions": {
    "noEmit": true,
    "jsx": "preserve",
    "lib": ["esnext", "dom", "dom.iterable"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "plugins": [
    {
      "name": "next"
    }
  ]
}
